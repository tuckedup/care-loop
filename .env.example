# CareLoop environment template. Copy to .env (never commit .env). All data is synthetic.

# Postgres. Default matches docker-compose.yml; swap for the Supabase pooler URL in production.
DATABASE_URL=postgres://careloop:careloop@localhost:54329/careloop

# Anthropic (risk-signal extraction + clinician summary). Leave the key empty to run on fixtures only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Langfuse tracing (optional; traces are skipped when keys are absent)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Email notifications (optional)
RESEND_API_KEY=

# Signed demo-auth cookie. Generate a long random string for any non-local use.
SESSION_SECRET=dev-only-change-me-dev-only-change-me

# Business config
REFILL_LIMIT=2
SAMPLE_RATE=0.2
SEED=42

# Shared secret for /api/cron/outbox (Authorization: Bearer <value>). Unset => the route returns 401.
CRON_SECRET=

# Absolute trusted pharmacy endpoint. Required in production and must use HTTPS.
# Local development can leave it unset; the app origin is used only outside production.
PHARMACY_BASE_URL=

# --- Deployment and hardening (template values only; never commit real secrets) ---

# The demo role switcher is DEFAULT-DENY in production builds. Set to "true" only for a public demo
# where letting anyone pick a role is acceptable (synthetic data). Not real authentication.
DEMO_AUTH_ENABLED=

# Hours before an accepted-but-unfilled pharmacy renewal is flagged as stalled (default 72; demo config).
PHARMACY_STALE_HOURS=

# Alternate Next.js build directory (parallel dev servers / e2e runs must not share one).
NEXT_DIST_DIR=

# Per-minute login (role switch) budget per IP; default 20. For e2e only; never raise in production.
LOGIN_RATE_LIMIT_PER_MIN=

# Ship the CSP as Content-Security-Policy-Report-Only (build time). Leave unset to enforce.
CSP_REPORT_ONLY=

# Dev/test-only switches for scripted tests. NEVER set these in production: they are ignored unless
# NODE_ENV is exactly "development" or "test". Leave commented out.
# MOCK_PHARMACY_FORCE=retry-then-fill
# RISK_FIXTURE=synthetic-handwritten
# SUMMARY_FIXTURE=synthetic-handwritten
# VISIT_CLOCK_OFFSET_DAYS=60
